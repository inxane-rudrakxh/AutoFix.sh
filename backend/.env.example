# ── Server ────────────────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=INFO

# ── GitHub App ─────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/apps/new
GITHUB_APP_ID=your_app_id
GITHUB_APP_PRIVATE_KEY=path/to/private-key.pem  # or paste PEM content directly
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_CLIENT_ID=your_oauth_client_id
GITHUB_CLIENT_SECRET=your_oauth_client_secret

# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ── Docker Sandbox ──────────────────────────────────────────────────────────
SANDBOX_IMAGE=node:20-alpine
SANDBOX_TIMEOUT_SECONDS=180
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_TEST_COMMAND=npm ci && npm test

# ── Feature Flags ───────────────────────────────────────────────────────────
# Set AUTO_COMMIT_ENABLED=false to dry-run without pushing PRs
AUTO_COMMIT_ENABLED=true
SANDBOX_ENABLED=true

# ── Storage ──────────────────────────────────────────────────────────────────
WORKSPACE_DIR=/tmp/autofix
